# Orchestra Configuration

# API
ORCHESTRA_DB=/data/orchestra.db
ORCHESTRA_SKILLS_DIRS=/skills

# Orchestrator
CONSOLE_URL=http://api:8200
CLAUDE_PATH=claude
WORKSPACE_DIR=/workspace
FRENTES=
MAX_WORKERS=2
MAX_BUDGET_USD=10.0
WORKER_BUDGET_USD=2.0
REVIEWER_BUDGET_USD=1.0
ARCHITECT_BUDGET_USD=1.5
ARCHITECT_MODEL=opus
ARCHITECT_AUTO_APPROVE=true
WORKER_MODEL=sonnet
REVIEWER_MODEL=sonnet
WORKER_MAX_TURNS=15
LOCK_TTL_MIN=45
HEARTBEAT_S=60
POLL_S=30
DRY_RUN=false

# LLM backend: "claude" (default) or "ollama"
LLM_BACKEND=claude
OLLAMA_URL=http://ollama:11434
OLLAMA_ARCHITECT_MODEL=llama3.1:70b
OLLAMA_WORKER_MODEL=codellama:34b
OLLAMA_REVIEWER_MODEL=llama3.1:8b

# GitHub (optional — for auto-cloning repos)
GITHUB_ORG=
REPO_MAP=

# Integration branch (optional — if empty, tasks stay on isolated branches)
INTEGRATION_BRANCH=

# Docker target for e2e testing (optional)
DOCKER_TARGET=
